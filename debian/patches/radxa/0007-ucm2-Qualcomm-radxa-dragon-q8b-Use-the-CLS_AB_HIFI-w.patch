+++ b/src/ucm2/Qualcomm/sc8280xp/Dragon-Q8B-HiFi.conf
@@ -96,7 +96,7 @@ SectionDevice."HDMI2" {
 SectionDevice."Headphones" {
 	Comment "Headphones playback"
 
